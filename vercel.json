{
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://create-resumes.vercel.app/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "create-resume-ui.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/resume/:path*",
      "destination": "https://create-resume-backend-1dql.onrender.com/resume/:path*"
    }
  ]
}
